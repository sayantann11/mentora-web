# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.in
# Digits only, with country code (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Supabase (server-only service key; NEVER prefix it with NEXT_PUBLIC_) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin ──────────────────────────────────────────────
# Comma-separated allow-list. Each admin must also exist as a user in Supabase Auth.
ADMIN_EMAILS=you@your-domain.in
# Local development only (ignored when NODE_ENV=production): skip admin login.
DEV_ADMIN_BYPASS=false

# ─── UPI (direct, manual verification) ──────────────────
UPI_ID=yourbusiness@okicici
# Exactly as it appears in your UPI app
UPI_PAYEE_NAME=Your Business Name
# Some apps reject `tr=` for personal VPAs — set false if payments fail
UPI_INCLUDE_TR=true

# ─── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Mentora <hello@your-domain.in>
ADMIN_NOTIFY_EMAIL=you@your-domain.in

# ─── Spam protection (Cloudflare Turnstile) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Security ───────────────────────────────────────────
# Long random strings: `openssl rand -hex 32`
IP_HASH_SALT=
CRON_SECRET=

# ─── Analytics (loaded only after cookie consent) ───────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ENABLE_META_PIXEL=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_ENABLE_GOOGLE_ADS=false
NEXT_PUBLIC_GOOGLE_ADS_ID=
